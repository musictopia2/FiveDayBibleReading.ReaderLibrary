<LeftOverLayout>
    <TopContent>
        @ChildContent
        @if (_keyboard == false)
        {
            <PrimaryButton OnClick="ManuallyOpenCloseFullScreenAsync">
                @GetDisplay
            </PrimaryButton>
            <ArrowDownComponent TargetHeight="6vh" Clicked="ProcessArrowDown" />
        }
    </TopContent>
    <MainContent>
        @if (Chapter > 0)
        {
            <ReaderComponent CanFocusFirst="true"
            RenderList="_verses"
            Height="100%"
            @ref="_reader"
            DataContext="_tempModel"
            Context="verse"
            Width="100%">
                @verse
            </ReaderComponent>
        }
    </MainContent>
    <BottomContent>
        
        <fieldset disabled="@_processingClick"
                  style="border: 0; padding: 0; margin: 0;">
            <PrimaryButton OnClick="ProcessAsync">
                @(_processingClick ? "Loading..." : GetButtonText())
            </PrimaryButton>
        </fieldset>
    </BottomContent>
</LeftOverLayout>